---
import '../styles/global.css';
import { profile } from '../data/content';
// Preload the hero display face (largest text, LCP) and the body face so they don't swap in late.
import syneDisplay from '@fontsource/syne/files/syne-latin-800-normal.woff2?url';
import manropeBody from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = `${profile.name} Hussain`,
	description = `${profile.role} in Lahore, currently a Java developer at ${profile.company}. I build fast, modern web apps with React, Next.js, Java, Node.js, and Python.`,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.role,
	worksFor: { '@type': 'Organization', name: profile.company },
	address: { '@type': 'PostalAddress', addressLocality: 'Lahore', addressCountry: 'PK' },
	email: `mailto:${profile.email}`,
	url: Astro.site?.href,
	sameAs: [profile.github, profile.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#FAFAFA" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="preload" href={syneDisplay} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={manropeBody} as="font" type="font/woff2" crossorigin />

		<!-- Open Graph / social previews -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(person)} />

		<!--
			Pre-paint guard: hide reveal targets only when motion will run,
			and un-hide after 3s if page.ts never reports ready.
		-->
		<script is:inline>
			// Reloads start at the top instead of the browser restoring the old scroll offset.
			history.scrollRestoration = 'manual';
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const root = document.documentElement;
				root.classList.add('motion');
				setTimeout(() => {
					if (!root.classList.contains('motion-ready')) root.classList.remove('motion');
				}, 3000);
			}
		</script>
		<slot name="head" />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-label focus:uppercase focus:text-paper"
			>Skip to content</a
		>
		<slot />
		<script>
			import '../scripts/page';
		</script>
	</body>
</html>
