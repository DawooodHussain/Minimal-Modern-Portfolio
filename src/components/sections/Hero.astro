---
import Icon from '../Icon.astro';
import { profile } from '../../data/content';
---

<!-- Status strip: solid fill, no blur (design system forbids backdrop effects). -->
<div class="z-30 lg:sticky lg:top-16 flex items-center justify-between gap-3 border-b border-mist bg-paper px-5 py-2 font-mono text-label-sm uppercase text-graphite md:px-margin">
	<div class="flex min-w-0 items-center gap-2 text-ink">
		<span class="live-mark"></span>
		<span class="truncate font-bold">Open to freelance work</span>
	</div>
	<div class="flex shrink-0 items-center gap-4">
		<span>Lahore, PK / Remote</span>
		<span class="hidden text-mist sm:inline">·</span>
		<span class="hidden sm:inline">React · Python · Node · Java</span>
	</div>
</div>

<section id="hero" data-section="hero" class="relative overflow-hidden border-b border-mist">
	<div class="mx-auto grid max-w-[1440px] grid-cols-1 lg:min-h-[calc(100svh-6.25rem)] lg:grid-cols-12">
		<aside class="flex flex-col justify-between gap-6 border-b border-mist p-5 font-mono text-label-sm uppercase text-graphite sm:p-8 lg:col-span-3 lg:border-r lg:border-b-0">
			<div class="space-y-6">
				<div class="text-label font-bold text-ink">Portfolio {profile.year}</div>
				<dl class="grid grid-cols-2 gap-5 lg:grid-cols-1">
					<div class="space-y-1">
						<dt>Role</dt>
						<dd class="font-bold text-ink">{profile.role}</dd>
					</div>
					<div class="space-y-1">
						<dt>Specialty</dt>
						<dd class="text-ink">{profile.specialty}</dd>
					</div>
					<div class="col-span-2 space-y-1 lg:col-span-1">
						<dt>Location</dt>
						<dd class="text-ink">{profile.location}</dd>
					</div>
				</dl>
			</div>
			<div class="hidden border-t border-mist pt-6 lg:block">
				<span>Local time</span>
				<span class="ml-2 tabular-nums text-ink" data-clock>--:--</span>
				<span class="ml-1">PKT</span>
			</div>
		</aside>

		<div class="flex flex-col justify-between gap-10 p-5 sm:p-8 md:p-10 lg:col-span-9">
			<div class="space-y-6">
				<div class="font-mono text-label-sm uppercase tracking-widest text-graphite">Hi, I’m</div>

				<!--
					Sized in container units so the wide Syne caps always fill, never overflow, the column.
					Letters are split at build time for the CSS rise-in; screen readers get the plain name.
				-->
				<h1 class="@container select-none font-display font-extrabold uppercase" aria-label={profile.name}>
					<span class="glitch text-[20cqi] leading-[0.85] tracking-[-0.04em]" data-text={profile.name} aria-hidden="true">
						{[...profile.name].map((ch, i) => <span class="hero-char"><span style={`--i:${i}`}>{ch}</span></span>)}
					</span>
				</h1>

				<p class="max-w-4xl font-display text-[clamp(1.5rem,3.2vw,2.5rem)] font-bold uppercase leading-[1.08] tracking-tight" data-reveal>
					Full stack developer building fast, modern web apps and smooth interactive experiences.
				</p>

				<p class="max-w-[60ch] text-body-lead text-graphite" data-reveal style="--i:2">
					I build web apps end to end — React and Next.js on the front, Java, Node.js, and Python behind them. Currently a Java developer at BrickxAI.
				</p>
			</div>

			<div class="grid grid-cols-1 gap-6 border-t border-mist pt-8 sm:grid-cols-2 md:grid-cols-3" data-reveal-group>
				<div class="space-y-2">
					<div class="font-mono text-label font-bold uppercase">Core capabilities</div>
					<p class="text-graphite">Scalable APIs, end-to-end product builds, relational &amp; NoSQL databases, and microservices.</p>
				</div>
				<div class="space-y-2">
					<div class="font-mono text-label font-bold uppercase">Stack</div>
					<p class="text-graphite">React, Next.js, Node.js, Python, Spring Boot, TypeScript, PostgreSQL, and GSAP.</p>
				</div>
				<div class="flex flex-col justify-end gap-3 sm:col-span-2 md:col-span-1">
					<a
						href="#work"
						class="group flex items-center justify-between rounded-ctl border border-ink bg-ink px-4 py-3 font-mono text-label font-bold uppercase text-paper transition-colors duration-150 hover:bg-paper hover:text-ink"
					>
						<span>View selected work</span><Icon name="arrow-right" class="arrow" />
					</a>
					<a
						href="#contact"
						class="group flex items-center justify-between rounded-ctl border border-mist px-4 py-3 font-mono text-label uppercase transition-colors duration-150 hover:border-ink hover:bg-fog"
					>
						<span>Get in touch</span><Icon name="arrow-right" class="arrow" />
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
