---
import Icon from './Icon.astro';
import { profile } from '../data/content';

const facts = [
	{ k: 'Developer', v: profile.name },
	{ k: 'Focus', v: 'Full stack & motion' },
	{ k: 'Contact', v: profile.email, lower: true },
	{ k: 'Availability', v: 'Open to freelance work', live: true },
];
---

<footer class="border-t border-mist bg-fog">
	<div class="mx-auto w-full max-w-[1440px] px-5 py-10 md:px-margin md:py-12 lg:pb-16">
		<dl class="mb-8 grid grid-cols-2 gap-6 border-b border-mist pb-8 lg:grid-cols-4">
			{
				facts.map((f) => (
					<div class="flex flex-col gap-1">
						<dt class="font-mono text-label-sm uppercase text-graphite">{f.k}</dt>
						<dd class:list={['flex items-center gap-2 break-all font-mono text-label font-bold', f.lower ? 'normal-case' : 'uppercase']}>
							{f.live && <span class="live-mark" />}
							{f.v}
						</dd>
					</div>
				))
			}
		</dl>
		<div class="flex flex-col justify-between gap-4 font-mono text-label-sm uppercase text-graphite sm:flex-row sm:items-center">
			<span>© {profile.year} {profile.name} — Designed &amp; engineered with care</span>
			<span class="flex items-center gap-6">
				{profile.resume && <a href={profile.resume} class="hairline-link font-bold text-ink">Resume</a>}
				<a href="#hero" class="hairline-link inline-flex items-center gap-1.5 font-bold text-ink">Back to top <Icon name="arrow-up" /></a>
			</span>
		</div>
	</div>
</footer>
