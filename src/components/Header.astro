---
import { nav, profile } from '../data/content';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-mist bg-paper">
	<div class="mx-auto flex h-16 w-full max-w-[1440px] items-center justify-between gap-4 px-5 md:px-margin">
		<a href="#hero" class="flex shrink-0 items-baseline gap-2">
			<span class="font-display text-headline-sm font-bold uppercase tracking-tight">
				{profile.name}
			</span>
			<span class="hidden font-mono text-label-sm uppercase text-graphite lg:inline">· {profile.role}</span>
			<span class="sr-only">, back to top</span>
		</a>

		<nav aria-label="Primary" class="flex h-full items-center gap-3 sm:gap-5 md:gap-8">
			{
				nav.map((item) => (
					<a
						href={`#${item.id}`}
						data-nav={item.id}
						class="hairline-link whitespace-nowrap font-mono text-label-sm uppercase text-graphite transition-colors hover:text-ink aria-[current=true]:text-ink sm:text-label"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="hidden shrink-0 items-center gap-5 sm:flex">
			{profile.resume && <a href={profile.resume} class="hairline-link font-mono text-label uppercase text-graphite transition-colors hover:text-ink">Resume</a>}
			<a
				href={`mailto:${profile.email}`}
				class="shrink-0 rounded-ctl border border-ink px-4 py-1.5 font-mono text-label-sm font-bold uppercase transition-colors hover:bg-ink hover:text-paper"
			>
				Say hello
			</a>
		</div>
	</div>
	<!-- Scroll progress hairline, driven by a CSS scroll timeline (global.css) -->
	<div class="scroll-progress absolute inset-x-0 -bottom-px h-px origin-left bg-ink" aria-hidden="true"></div>
</header>
